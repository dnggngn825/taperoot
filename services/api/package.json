{
  "name": "@taperoot/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate:dev": "prisma migrate dev --env-file ../../.env",
    "migrate:deploy": "prisma migrate deploy --env-file ../../.env",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@pothos/core": "^4.13.0",
    "@pothos/plugin-prisma": "^4.14.3",
    "@prisma/client": "^5.22.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.2",
    "prisma": "^5.22.0",
    "prisma-pothos-types": "^1.0.0"
  }
}
