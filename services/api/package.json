{
  "name": "@taperoot/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate:dev": "prisma migrate dev --env-file ../../.env",
    "migrate:deploy": "prisma migrate deploy --env-file ../../.env",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx --env-file=../../.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0"
  }
}
