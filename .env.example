# Anthropic API key — optional; mock extractor runs when absent
ANTHROPIC_API_KEY=

# SQLite database path (inside the API container / relative for local dev)
DATABASE_URL=file:../../../data/taperoot.db

# gRPC extraction service address
EXTRACTION_ADDR=extraction:50051

# Service ports
API_PORT=4000
EXTRACTION_PORT=50051
WEB_PORT=8080
